--============================================================================
local HiddenElements = {}
local HudKeywords = { "crosshair", "crossair", "reticle", "reticule", "aim", "sight", "scope", "cursor" }

local function isOurs(inst)
	return inst == CrosshairGui or inst == MenuGui
		or inst:IsDescendantOf(CrosshairGui) or inst:IsDescendantOf(MenuGui)
end

local function looksLikeCrosshair(name)
	local lower = name:lower()
	for _, kw in ipairs(HudKeywords) do
		if lower:find(kw, 1, true) then return true end
	end
	return false
end

local function collectHud()
	local out = {}
	for _, gui in ipairs(PlayerGui:GetChildren()) do
		if gui:IsA("ScreenGui") and not isOurs(gui) then
			table.insert(out, gui)
			for _, d in ipairs(gui:GetDescendants()) do
				if d:IsA("GuiObject") and looksLikeCrosshair(d.Name) then
					table.insert(out, d)
				end
			end
		end
	end
	return out
end

local function setHidden(inst, hidden)
	if not inst or not inst.Parent then return end
	local prop = inst:IsA("ScreenGui") and "Enabled" or "Visible"
	if hidden then
		if HiddenElements[inst] == nil then HiddenElements[inst] = inst[prop] end
		inst[prop] = false
	elseif HiddenElements[inst] ~= nil then
		inst[prop] = HiddenElements[inst]
		HiddenElements[inst] = nil
	end
end

local function restoreAll()
	for inst, original in pairs(HiddenElements) do
		if inst and inst.Parent then
			local prop = inst:IsA("ScreenGui") and "Enabled" or "Visible"
			inst[prop] = original
		end
	end
	table.clear(HiddenElements)
end

