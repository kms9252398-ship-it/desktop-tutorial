local function CreateRenderer(parent)
	local R = { parent = parent, arms = {}, mainParts = {}, outParts = {}, circles = {} }

	function R:Clear()
		for _, c in ipairs(self.parent:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		table.clear(self.arms); table.clear(self.mainParts)
		table.clear(self.outParts); table.clear(self.circles)
	end

	function R:_main(inst, prop) table.insert(self.mainParts, { inst, prop or "BackgroundColor3" }) end
	function R:_out(inst, prop)  table.insert(self.outParts,  { inst, prop or "BackgroundColor3" }) end

	function R:_arm(dirX, dirY, len, thick)
		local horizontal = (dirY == 0)
		local w = horizontal and len or thick
		local h = horizontal and thick or len

		local outline
		if Config.Outline then
			outline = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(w + Config.OutlineSize * 2, h + Config.OutlineSize * 2),
				BackgroundColor3 = Config.OutlineColor,
				BorderSizePixel = 0, ZIndex = 1,
			}, self.parent)
			self:_out(outline)
		end

		local frame = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(w, h),
			BackgroundColor3 = Config.Color,
			BorderSizePixel = 0, ZIndex = 2,
		}, self.parent)
		self:_main(frame)

		table.insert(self.arms, { frame = frame, outline = outline, dx = dirX, dy = dirY, base = len / 2 })
	end

	function R:_ring(radius, thick, rotation, round)
		if Config.Outline then
			local o = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(0, 0),
				Size = UDim2.fromOffset(radius * 2, radius * 2),
				BackgroundTransparency = 1,
				Rotation = rotation or 0, ZIndex = 1,
			}, self.parent)
			if round then new("UICorner", { CornerRadius = UDim.new(1, 0) }, o) end
			local os_ = new("UIStroke", { Color = Config.OutlineColor, Thickness = thick + Config.OutlineSize * 2 }, o)
			self:_out(os_, "Color")
			table.insert(self.circles, { frame = o, base = radius })
		end
		local c = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(0, 0),
			Size = UDim2.fromOffset(radius * 2, radius * 2),
			BackgroundTransparency = 1,
			Rotation = rotation or 0, ZIndex = 2,
		}, self.parent)
		if round then new("UICorner", { CornerRadius = UDim.new(1, 0) }, c) end
		local st = new("UIStroke", { Color = Config.Color, Thickness = thick }, c)
		self:_main(st, "Color")
		table.insert(self.circles, { frame = c, base = radius })
	end

	function R:_dot()
		local d = Config.DotSize * 2
		if Config.Outline then
			local o = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(d + Config.OutlineSize * 2, d + Config.OutlineSize * 2),
				BackgroundColor3 = Config.OutlineColor,
				BorderSizePixel = 0, ZIndex = 3,
			}, self.parent)
			if Config.DotRound then new("UICorner", { CornerRadius = UDim.new(1, 0) }, o) end
			self:_out(o)
		end
		local dot = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(d, d),
			BackgroundColor3 = Config.Color,
			BorderSizePixel = 0, ZIndex = 4,
		}, self.parent)
		if Config.DotRound then new("UICorner", { CornerRadius = UDim.new(1, 0) }, dot) end
		self:_main(dot)
	end

	function R:_bracket()
		local L, T, G = Config.Length, Config.Thickness, Config.Gap
		for _, sx in ipairs({ -1, 1 }) do
			for _, sy in ipairs({ -1, 1 }) do
				local pieces = {
					{ UDim2.fromOffset(sx * (G + L / 2), sy * G), L, T },
					{ UDim2.fromOffset(sx * G, sy * (G + L / 2)), T, L },
				}
				for _, p in ipairs(pieces) do
					if Config.Outline then
						local o = new("Frame", {
							AnchorPoint = Vector2.new(0.5, 0.5),
							Position = p[1],
							Size = UDim2.fromOffset(p[2] + Config.OutlineSize * 2, p[3] + Config.OutlineSize * 2),
							BackgroundColor3 = Config.OutlineColor,
							BorderSizePixel = 0, ZIndex = 1,
						}, self.parent)
						self:_out(o)
					end
					local f = new("Frame", {
						AnchorPoint = Vector2.new(0.5, 0.5),
						Position = p[1],
						Size = UDim2.fromOffset(p[2], p[3]),
						BackgroundColor3 = Config.Color,
						BorderSizePixel = 0, ZIndex = 2,
					}, self.parent)
					self:_main(f)
				end
			end
		end
	end

	function R:Build()
		self:Clear()
		local shape = Config.Shape

		if ShapeArms[shape] then
			local allowed = ShapeArms[shape]
			local order = { { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } }
			local flags = { Config.ArmTop, Config.ArmBottom, Config.ArmLeft, Config.ArmRight }
			for i, d in ipairs(order) do
				if allowed[i] and flags[i] then
					self:_arm(d[1], d[2], Config.Length, Config.Thickness)
				end
			end
		elseif shape == "Brackets" then
			self:_bracket()
		elseif shape == "Diamond" then
			self:_ring(Config.CircleRadius, Config.CircleThick, 45, false)
		elseif shape == "Square" then
			self:_ring(Config.CircleRadius, Config.CircleThick, 0, false)
		elseif shape == "Chevron" then
			self:_arm(-1, 0, Config.Length, Config.Thickness)
			self:_arm(1, 0, Config.Length, Config.Thickness)
			self:_arm(0, 1, Config.Length, Config.Thickness)
		end

		if Config.Circle then self:_ring(Config.CircleRadius, Config.CircleThick, 0, true) end
		if Config.Dot then self:_dot() end

		self:ApplySpread(spread)
		self:ApplyColor()
	end

	function R:ApplySpread(v)
		local gap = math.max(0, Config.Gap + v)
		for _, arm in ipairs(self.arms) do
			local dist = gap + arm.base
			local x, y = arm.dx * dist, arm.dy * dist
			arm.frame.Position = UDim2.fromOffset(x, y)
			if arm.outline then arm.outline.Position = UDim2.fromOffset(x, y) end
		end
		for _, c in ipairs(self.circles) do
			local r = math.max(1, c.base + v)
			c.frame.Size = UDim2.fromOffset(r * 2, r * 2)
		end
	end

	function R:ApplyColor()
		local col = Config.Color
		if Config.Chroma then
			col = Color3.fromHSV(chromaT % 1, 1, 1)
		elseif aiming and Config.AdsColorOn then
			col = Config.AdsColor
		end
		for _, p in ipairs(self.mainParts) do
			p[1][p[2]] = col
			if p[2] == "BackgroundColor3" then
				p[1].BackgroundTransparency = Config.Transparency
			else
				p[1].Transparency = Config.Transparency
			end
		end
		for _, p in ipairs(self.outParts) do
			p[1][p[2]] = Config.OutlineColor
			if p[2] == "BackgroundColor3" then
				p[1].BackgroundTransparency = Config.Transparency
			else
				p[1].Transparency = Config.Transparency
			end
		end
	end

	return R
end

