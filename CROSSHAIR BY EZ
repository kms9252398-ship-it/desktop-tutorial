			v = 1 - math.clamp((i.Position.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
			refresh()
		elseif dragHue then
			h = math.clamp((i.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
			refresh()
		end
	end)

	swatch.MouseButton1Click:Connect(function()
		if popup.Visible then popup.Visible = false return end
		popup.Position = UDim2.fromOffset(
			math.clamp(swatch.AbsolutePosition.X - Window.AbsolutePosition.X - 160, 4, Window.AbsoluteSize.X - 200),
			math.clamp(swatch.AbsolutePosition.Y - Window.AbsolutePosition.Y + 18, 4, Window.AbsoluteSize.Y - 174)
		)
		popup.Visible = true
	end)

	attachTooltip(row, tip)
	refresh(true)
	return api
end

