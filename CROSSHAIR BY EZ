_G.Crosshair = {
	Punch      = function(_, amount) punch += (amount or Config.PunchAmount) end,
	Hit        = function(_, isKill) playHitmarker(isKill and true or false) end,
	SetAiming  = function(_, v) aiming = v and true or false; Main:ApplyColor() end,
	SetVisible = function(_, v) forcedHidden = not v end,
	Notify     = function(_, text, dur) Notify(text, dur) end,
	Get        = snapshot,
	Load       = function(_, data) restore(data); syncControls(); rebuild() end,
	HideHudElement = function(_, inst, hidden) setHidden(inst, hidden ~= false) end,
	RestoreHud = function() restoreAll() end,
}

