--============================================================================
-- 동기화 / 프리셋
--============================================================================
function syncControls()
	for key, ctrl in pairs(Controls) do
		if Config[key] ~= nil and ctrl and ctrl.Set then
			ctrl:Set(Config[key], true)
		end
	end
	Anchor.Position = UDim2.new(0.5, Config.OffsetX, 0.5, Config.OffsetY)
	Watermark.Visible = Config.Watermark
	UserInputService.MouseIconEnabled = not Config.HideCursor
	HitSound.SoundId = Config.HitSoundId
	HitSound.Volume = Config.HitVolume
end

function applyPreset(data)
	for k, v in pairs(data) do Config[k] = v end
	if ShapeArms[Config.Shape] then
		local a = ShapeArms[Config.Shape]
		Config.ArmTop, Config.ArmBottom, Config.ArmLeft, Config.ArmRight = a[1], a[2], a[3], a[4]
	end
	syncControls()
	rebuild()
end

--============================================================================
-- 메인 루프
--============================================================================
local wmTimer = 0
RunService.RenderStepped:Connect(function(dt)
	-- 표시 조건
	local visible = Config.Enabled and not forcedHidden
	if visible and Config.HideWhenDead then
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then visible = false end
	end
	if visible and Config.HideWhenFree and UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
		visible = false
	end
	if visible and aiming and Config.AdsHide then visible = false end
	Container.Visible = visible

	-- 스프레드
	local target = 0
	if Config.Dynamic then
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			if hum.MoveDirection.Magnitude > 0.1 then target += Config.MoveSpread end
			local st = hum:GetState()
			if st == Enum.HumanoidStateType.Freefall or st == Enum.HumanoidStateType.Jumping then
				target += Config.JumpSpread
			end
			if hum.WalkSpeed > 0 and hum.WalkSpeed < 8 then
				target += Config.CrouchSpread
			end
		end
	end
	punch = math.max(0, punch - Config.Recovery * dt * 6)
	target += punch

	local a = math.clamp(dt * Config.Recovery, 0, 1)
	local ns = spread + (target - spread) * a
	if math.abs(ns - spread) > 0.03 then
		spread = ns
		Main:ApplySpread(spread)
		if Preview and Window.Visible then Preview:ApplySpread(spread) end
	end

	-- 크로마
	if Config.Chroma then
		chromaT += dt * Config.ChromaSpeed * 0.2
		Main:ApplyColor()
		if Preview and Window.Visible then Preview:ApplyColor() end
	end

	-- 크기 / 회전
	local scale = Config.Scale
	if aiming then scale *= Config.AdsScale end
	if Config.Pulse then
		pulseT += dt * Config.PulseSpeed
		scale *= 1 + math.sin(pulseT) * Config.PulseAmount
	end
	ContainerScale.Scale = math.max(0.05, scale)
	if PreviewScale then PreviewScale.Scale = math.max(0.05, Config.Scale) end

	if Config.Spin then spinAng = (spinAng + Config.SpinSpeed * dt) % 360 end
	Container.Rotation = Config.Rotation + spinAng
	if PreviewContainer then PreviewContainer.Rotation = Config.Rotation + spinAng end

	-- 워터마크
	wmTimer += dt
	if Config.Watermark and wmTimer > 0.25 then
		wmTimer = 0
		local fps = math.floor(1 / math.max(dt, 0.001) + 0.5)
		local ping = 0
		pcall(function()
			ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5)
		end)
		WatermarkText.Text = string.format("crosshair | %s | %d fps | %d ms | %s",
			LocalPlayer.Name, fps, ping, os.date("%H:%M:%S"))
	end
end)

