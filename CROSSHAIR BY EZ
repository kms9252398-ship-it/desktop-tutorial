local function playHitmarker(isKill)
	if not Config.Hitmarker then return end
	local col = isKill and Config.KillColor or Config.HitColor
	local L, G, T = Config.HitSize, Config.HitGap, Config.HitThick

	if Config.HitSound then
		HitSound.SoundId = Config.HitSoundId
		HitSound.Volume = Config.HitVolume
		HitSound.PlaybackSpeed = isKill and 0.85 or 1
		HitSound:Play()
	end

	for _, d in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		local rot = (d[1] * d[2] > 0) and 45 or -45
		local dist = G + L / 2
		local f = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(d[1] * dist, d[2] * dist),
			Size = UDim2.fromOffset(T, L),
			Rotation = rot,
			BackgroundColor3 = col,
			BorderSizePixel = 0, ZIndex = 10,
		}, HitLayer)
		stroke(f, Color3.new(0, 0, 0), 1)

		TweenService:Create(f, TweenInfo.new(Config.HitDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.fromOffset(d[1] * (dist + 6), d[2] * (dist + 6)),
			BackgroundTransparency = 1,
		}):Play()
		task.delay(Config.HitDuration + 0.05, function()
			if f then f:Destroy() end
		end)
	end
end

