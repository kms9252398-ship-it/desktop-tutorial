local function Slider(parent, text, min, max, default, step, callback, tip)
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1 }, parent)

	new("TextLabel", {
		Size = UDim2.new(1, -50, 0, 14),
		BackgroundTransparency = 1,
		Font = Theme.Font, TextSize = Theme.TextSize,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = text,
	}, row)
	local valueLabel = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundTransparency = 1,
		Font = Theme.Font, TextSize = Theme.TextSize,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "",
	}, row)

	local bar = new("Frame", {
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
	}, row)
	stroke(bar, Theme.Black, 1)
	local fill = accentize(new("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0 }, bar))

	local value = default
	local api = {}
	function api:Set(v, silent)
		if type(v) ~= "number" then return end
		v = math.clamp(v, min, max)
		if step and step > 0 then v = math.floor(v / step + 0.5) * step end
		v = math.floor(v * 1000 + 0.5) / 1000
		value = v
		fill.Size = UDim2.fromScale((v - min) / (max - min), 1)
		valueLabel.Text = tostring(v)
		if not silent then callback(v) end
	end
	function api:Get() return value end

	local dragging = false
	local function update(i)
		local rel = (i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
		api:Set(min + (max - min) * math.clamp(rel, 0, 1))
	end
	bar.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true; update(i)
		end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			update(i)
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	attachTooltip(row, tip)
	api:Set(default, true)
	return api
end

