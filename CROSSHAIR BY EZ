		local color = Color3.fromHSV(h, s, v)
		swatch.BackgroundColor3 = color
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		cursor.Position = UDim2.fromScale(s, 1 - v)
		hueCursor.Position = UDim2.fromScale(h, 0)
		hexBox.Text = string.format("#%02X%02X%02X",
			math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
		if not silent then callback(color) end
	end

	function api:Set(color, silent)
		if typeof(color) ~= "Color3" then return end
		h, s, v = Color3.toHSV(color)
		refresh(silent)
	end
	function api:Get() return Color3.fromHSV(h, s, v) end

	hexBox.FocusLost:Connect(function()
		local hex = hexBox.Text:gsub("#", "")
		local n = tonumber(hex, 16)
		if #hex == 6 and n then
			api:Set(Color3.fromRGB(math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256))
		else
			refresh(true)
		end
	end)

