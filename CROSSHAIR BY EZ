	end
	for _, inst in ipairs(items) do
		local suffix = (not inst:IsA("ScreenGui")) and "  <조준선 후보>" or ""
		Toggle(hudListHolder, inst.Name .. suffix, HiddenElements[inst] ~= nil, function(v)
