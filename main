--==================================================

CreateFeatureCard(
	TriggerTab.Page,
	"Trigger Bot",
	Settings.TriggerBotEnabled,
	function(value)

		Settings.TriggerBotEnabled =
			value

		Feature_TriggerBot(
			value
		)
	end
)

CreateInfoCard(
	TriggerTab.Page,
	"Connection slot:\n"
	..
	"Feature_TriggerBot()"
)

