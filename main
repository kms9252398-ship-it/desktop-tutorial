--==================================================
-- DEFAULT TAB
--==================================================

SetActiveTab(
	AimbotTab
)

--==================================================
-- DRAG
--==================================================

local dragging =
	false

local dragStart =
	nil

local startPosition =
	nil

TitleBar.InputBegan:Connect(
	function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or
			input.UserInputType ==
			Enum.UserInputType.Touch then

			dragging =
				true

			dragStart =
				input.Position

			startPosition =
				Panel.Position
		end
	end
)

UserInputService.InputChanged:Connect(
	function(input)

		if not dragging then
			return
		end

		if input.UserInputType ==
			Enum.UserInputType.MouseMovement
			or
			input.UserInputType ==
			Enum.UserInputType.Touch then

			local delta =
				input.Position -
				dragStart

			Panel.Position =
				UDim2.new(
					startPosition.X.Scale,
					startPosition.X.Offset +
					delta.X,

					startPosition.Y.Scale,
					startPosition.Y.Offset +
					delta.Y
				)
		end
	end
)

UserInputService.InputEnded:Connect(
	function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or
			input.UserInputType ==
			Enum.UserInputType.Touch then

			dragging =
				false
		end
	end
)

--==================================================
-- UI TOGGLE
--==================================================

UserInputService.InputBegan:Connect(
	function(
		input,
		gameProcessed
	)

		if gameProcessed then
			return
		end

		if input.KeyCode ==
			Enum.KeyCode.RightShift then

			Panel.Visible =
				not Panel.Visible
		end
	end
)

--==================================================
-- INITIALIZE
--==================================================

Panel.Visible =
	true

ApplyWalkSpeed()

print(
	"[CHAOS RIVAL BETA] Loaded."
)
