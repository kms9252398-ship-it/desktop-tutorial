function Section:AddInput(id, opts)
	opts = opts or {}
	local cb = opts.Callback or function() end

	local row = Row(self)
	RowLabel(row, opts.Text or id, 0.42)

	local holder = New("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.new(0.56, 0, 0, 26),
		BackgroundColor3 = T.SurfaceAlt,
		BorderSizePixel = 0,
		Parent = row,
	})
	Corner(6, holder)
	local stroke = Stroke(T.Border, 1, holder)

	local box = New("TextBox", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(9, 0),
		Size = UDim2.new(1, -18, 1, 0),
		Font = T.Font,
		Text = opts.Default or "",
		PlaceholderText = opts.Placeholder or "",
		PlaceholderColor3 = T.SubText,
		TextColor3 = T.Text,
		TextSize = T.TextSize,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Parent = holder,
	})

	local obj = { Value = box.Text, Type = "Input" }

	function obj:SetValue(v, silent)
		obj.Value = v
		box.Text = v
		if not silent then task.spawn(cb, v) end
	end
	function obj:OnChanged(fn) cb = fn end

	Library:Connect(box.Focused, function()
		Tween(stroke, TW.Snap, { Color = T.Accent })
	end)

	-- Fires on Enter / focus-loss only, not on every keystroke.
	Library:Connect(box.FocusLost, function()
		Tween(stroke, TW.Snap, { Color = T.Border })
		if box.Text ~= obj.Value then
			obj.Value = box.Text
			task.spawn(cb, box.Text)
		end
	end)

	Library.Options[id] = obj
	return obj
end

--------------------------------------------------------------- KEYBIND --
function Section:AddKeybind(id, opts)
	opts = opts or {}
	local cb = opts.Callback or function() end
	local key = opts.Default

	local row = Row(self)
	RowLabel(row, opts.Text or id, 0.5)

	local btn = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.new(0, 92, 0, 26),
		BackgroundColor3 = T.SurfaceAlt,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = T.Font,
		Text = key and key.Name or "None",
		TextColor3 = T.SubText,
		TextSize = T.TextSize,
		Parent = row,
	})
	Corner(6, btn)
	Stroke(T.Border, 1, btn)
	Hover(btn, T.SurfaceAlt, T.SurfaceHov)

	local obj = { Value = nil, Type = "Keybind" }

	-- Registered in the shared keybind table, so pressing a key is a single
	-- table lookup instead of walking every keybind's own listener.
	local fire = function() task.spawn(cb, obj.Value) end

	function obj:SetValue(v, silent)
		UnbindKey(obj.Value, fire)
		obj.Value = v
		BindKey(v, fire)
		btn.Text = v and v.Name or "None"
		btn.TextColor3 = v and T.Text or T.SubText
		if not silent then task.spawn(cb, v) end
	end
	function obj:OnChanged(fn) cb = fn end

	obj:SetValue(key, true)

	Library:Connect(btn.MouseButton1Click, function()
		btn.Text = "..."
		btn.TextColor3 = T.Accent
		Library._keyListener = function(keycode)
			if keycode == Enum.KeyCode.Backspace or keycode == Enum.KeyCode.Escape then
				obj:SetValue(nil, true)
			else
				obj:SetValue(keycode, true)
			end
		end
	end)

	Library.Options[id] = obj
	return obj
end

