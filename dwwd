--=====================================================================--
--  Nimbus UI  -  v1.0
--  A lightweight, themeable interface library for Roblox (Luau)
--
--  Design goals:
--    * Zero per-frame loops (no RenderStepped / Heartbeat driven layout)
--    * Cached TweenInfo, minimal instance count, no shadow spam
--    * AutomaticSize / AutomaticCanvasSize instead of manual resize loops
--    * Every connection tracked and released on :Unload()
--
--  Usage:
--    local Library = loadstring(game:HttpGet("<your url>"))()
--    local Window  = Library:CreateWindow({ Title = "My Menu" })
--    local Tab     = Window:AddTab("Main")
--    local Box     = Tab:AddSection("Left", "Graphics")
--    Box:AddToggle("VSync", { Text = "V-Sync", Default = true, Callback = print })
--=====================================================================--

