-- Running the script twice would otherwise leave a second full GUI tree and a
-- second set of input listeners alive, compounding the cost every re-run.
do
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	local old = pg and pg:FindFirstChild("NimbusUI")
	if old then old:Destroy() end
end

local ScreenGui = New("ScreenGui", {
	Name = "NimbusUI",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 999,
	Parent = LocalPlayer:WaitForChild("PlayerGui"),
})

-- Popups live here so dropdowns / colour pickers are never clipped by the
-- scrolling section they belong to.
local Overlay = New("Frame", {
	Name = "Overlay",
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	ZIndex = 50,
	Parent = ScreenGui,
})

Library.ScreenGui = ScreenGui

--=====================================================================--
--  DRAGGING
--=====================================================================--

-- Uses the shared dispatcher: no per-window InputChanged listener, and it
-- only runs while the pointer is actually moving during a drag.
local function MakeDraggable(frame, handle)
	Library:Connect(handle.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then return end

		ClosePopup()
		local origin = input.Position
		local startPos = frame.Position

		BeginDrag(function(pos)
			local d = pos - origin
			frame.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y
			)
		end, nil, nil)
	end)
end

