--=====================================================================--
--  INTERNALS
--=====================================================================--

-- Cached tween info. Building TweenInfo per call allocates on every hover.
local TW = {
	Snap = TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	Base = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	Soft = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
}

local function Tween(inst, info, props)
	local t = TweenService:Create(inst, info, props)
	t:Play()
	return t
end

-- Parent is applied LAST so the instance is only inserted into the
-- render tree once, fully configured. Measurably cheaper on big builds.
local function New(class, props, children)
	local inst = Instance.new(class)
	local parent = nil
	if props then
		for k, v in pairs(props) do
			if k == "Parent" then
				parent = v
			else
				inst[k] = v
			end
		end
	end
	if children then
		for _, c in ipairs(children) do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function Corner(radius, parent)
	return New("UICorner", { CornerRadius = UDim.new(0, radius or T.Corner), Parent = parent })
end

local function Stroke(color, thickness, parent)
	return New("UIStroke", {
		Color = color or T.Border,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function Pad(px, parent)
	return New("UIPadding", {
		PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px),
		Parent = parent,
	})
end

local function List(padding, parent)
	return New("UIListLayout", {
		Padding = UDim.new(0, padding),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

function Library:Connect(signal, fn)
	local conn = signal:Connect(fn)
	table.insert(self._connections, conn)
	return conn
end

-- Shared hover handler so every control does not allocate its own closures
-- for enter/leave colour maths.
local function Hover(inst, idle, hot)
	Library:Connect(inst.MouseEnter, function()
		Tween(inst, TW.Snap, { BackgroundColor3 = hot })
	end)
	Library:Connect(inst.MouseLeave, function()
		Tween(inst, TW.Snap, { BackgroundColor3 = idle })
	end)
end

local function InBounds(gui, pos)
	local ap, as = gui.AbsolutePosition, gui.AbsoluteSize
	return pos.X >= ap.X and pos.X <= ap.X + as.X
	   and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y
end

local function ClosePopup()
	if Library._openPopup then
		Library._openPopup.Visible = false
		Library._openPopup = nil
	end
end

local function OpenPopup(popup, anchor)
	ClosePopup()
	popup.Position = UDim2.fromOffset(
		anchor.AbsolutePosition.X,
		anchor.AbsolutePosition.Y + anchor.AbsoluteSize.Y + 6
	)
	popup.Visible = true
	Library._openPopup = popup
end

--=====================================================================--
--  CENTRAL INPUT DISPATCHER
--
--  The whole library uses exactly THREE UserInputService connections,
--  no matter how many sliders / keybinds / pickers you create.
--  (Previously each control added its own, so 30 sliders meant 90
--   closures running on every single mouse-move event.)
--=====================================================================--

Library._activeDrag  = nil   -- function(Vector3 position)
Library._dragEnd     = nil   -- function() called on mouse release
Library._keybinds    = {}    -- [Enum.KeyCode] = { fn, fn, ... }
Library._keyListener = nil   -- set while a keybind control is capturing

local function BeginDrag(moveFn, endFn, pos)
	Library._activeDrag = moveFn
	Library._dragEnd = endFn
	if pos then moveFn(pos) end
end

local function BindKey(keycode, fn)
	if not keycode then return end
	local list = Library._keybinds[keycode]
	if not list then
		list = {}
		Library._keybinds[keycode] = list
	end
	table.insert(list, fn)
end

local function UnbindKey(keycode, fn)
	local list = keycode and Library._keybinds[keycode]
	if not list then return end
	for i, f in ipairs(list) do
		if f == fn then
			table.remove(list, i)
			break
		end
	end
end

Library:Connect(UserInputService.InputChanged, function(input)
	local drag = Library._activeDrag
	if not drag then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement
	or input.UserInputType == Enum.UserInputType.Touch then
		drag(input.Position)
	end
end)

Library:Connect(UserInputService.InputEnded, function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1
	and input.UserInputType ~= Enum.UserInputType.Touch then return end
	if Library._activeDrag then
		Library._activeDrag = nil
		local fin = Library._dragEnd
		Library._dragEnd = nil
		if fin then fin() end
	end
end)

Library:Connect(UserInputService.InputBegan, function(input, gpe)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		local popup = Library._openPopup
		if popup and not InBounds(popup, input.Position) then
			task.defer(ClosePopup)
		end
		return
	end

	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

	-- A keybind control is waiting for a key: swallow this press.
	if Library._keyListener then
		local fn = Library._keyListener
		Library._keyListener = nil
		fn(input.KeyCode)
		return
	end

	if gpe then return end
	local list = Library._keybinds[input.KeyCode]
	if list then
		for _, fn in ipairs(list) do
			task.spawn(fn)
		end
	end
end)

