		AutoButtonColor = false,
		Text = "",
		Parent = row,
	})
	Corner(5, swatch)
	Stroke(T.Border, 1, swatch)

	local popup = New("Frame", {
		Visible = false,
		BackgroundColor3 = T.Titlebar,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(196, 176),
		ZIndex = 60,
		Parent = Overlay,
	})
	Corner(8, popup)
	Stroke(T.Border, 1, popup)
	Pad(10, popup)

	local sat = New("Frame", {
		Size = UDim2.new(1, 0, 0, 118),
		BackgroundColor3 = Color3.fromHSV(h, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 61,
		Parent = popup,
	})
	Corner(6, sat)

	New("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 62,
		Parent = sat,
	}, {
		New("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
		New("UICorner", { CornerRadius = UDim.new(0, 6) }),
	})

	New("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		ZIndex = 63,
		Parent = sat,
	}, {
		New("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(1, 0),
			}),
		}),
		New("UICorner", { CornerRadius = UDim.new(0, 6) }),
	})

	local cursor = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(10, 10),
		BackgroundTransparency = 1,
		ZIndex = 64,
		Parent = sat,
	})
	Corner(5, cursor)
	Stroke(Color3.new(1, 1, 1), 2, cursor)

	local hue = New("Frame", {
		Position = UDim2.new(0, 0, 0, 128),
		Size = UDim2.new(1, 0, 0, 14),
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 61,
		Parent = popup,
	})
	Corner(7, hue)
	New("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
		}),
		Parent = hue,
	})

	local hueCursor = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(6, 20),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 64,
		Parent = hue,
	})
	Corner(3, hueCursor)

	local obj = { Value = color, Type = "ColorPicker" }

	local function push(silent)
		local c = Color3.fromHSV(h, s, v)
		obj.Value = c
		swatch.BackgroundColor3 = c
		sat.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		cursor.Position = UDim2.fromScale(s, 1 - v)
		hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
		if not silent then task.spawn(cb, c) end
	end

	function obj:SetValue(c, silent)
		h, s, v = Color3.toHSV(c)
		push(silent)
	end
	function obj:OnChanged(fn) cb = fn end

	push(true)

	local function moveSat(p)
		local ap, as = sat.AbsolutePosition, sat.AbsoluteSize
		if as.X <= 0 or as.Y <= 0 then return end
		s = math.clamp((p.X - ap.X) / as.X, 0, 1)
		v = 1 - math.clamp((p.Y - ap.Y) / as.Y, 0, 1)
		push()
	end

	local function moveHue(p)
		local ap, as = hue.AbsolutePosition, hue.AbsoluteSize
		if as.X <= 0 then return end
		h = math.clamp((p.X - ap.X) / as.X, 0, 1)
		push()
	end

	Library:Connect(sat.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			BeginDrag(moveSat, nil, input.Position)
		end
	end)

	Library:Connect(hue.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			BeginDrag(moveHue, nil, input.Position)
		end
	end)

	Library:Connect(swatch.MouseButton1Click, function()
		if popup.Visible then ClosePopup() else OpenPopup(popup, swatch) end
	end)

	Library.Options[id] = obj
	return obj
end

