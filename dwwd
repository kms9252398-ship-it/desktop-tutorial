function Window:SelectTab(tab)
	ClosePopup()
	for _, t in ipairs(self.Tabs) do
		local on = (t == tab)
		t.Page.Visible = on
		Tween(t.Button, TW.Base, { BackgroundTransparency = on and 0 or 1 })
		Tween(t.Label, TW.Base, { TextColor3 = on and T.Text or T.SubText })
		Tween(t.Marker, TW.Base, { Size = UDim2.fromOffset(3, on and 18 or 0) })
	end
	self.ActiveTab = tab
end

function Window:SetVisible(state)
	self.Root.Visible = state
	if not state then ClosePopup() end
end

function Window:Toggle()
	self:SetVisible(not self.Root.Visible)
end

