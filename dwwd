local Section = {}
Section.__index = Section

local function Row(section, height)
	return New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height or T.RowHeight),
		Parent = section.Container,
	})
end

local function RowLabel(parent, text, width)
	return New("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(width or 1, width and 0 or -70, 1, 0),
		Font = T.Font,
		Text = text,
		TextColor3 = T.Text,
		TextSize = T.TextSize,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = parent,
	})
end

----------------------------------------------------------------- LABEL --
function Section:AddLabel(text, wrap)
	local lbl = New("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, wrap and 0 or 20),
		AutomaticSize = wrap and Enum.AutomaticSize.Y or Enum.AutomaticSize.None,
		Font = T.Font,
		Text = text,
		TextColor3 = T.SubText,
		TextSize = T.TextSize,
		TextWrapped = wrap or false,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = self.Container,
	})

	local api = {}
	function api:SetText(v) lbl.Text = v end
	return api
end

function Section:AddDivider()
	New("Frame", {
		BackgroundColor3 = T.Border,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 1),
		Parent = self.Container,
	})
end

---------------------------------------------------------------- BUTTON --
function Section:AddButton(text, opts)
	opts = opts or {}
	local fn = opts.Func or opts.Callback or function() end

	local btn = New("TextButton", {
		BackgroundColor3 = T.SurfaceAlt,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Size = UDim2.new(1, 0, 0, T.RowHeight),
		Font = T.Font,
		Text = text,
		TextColor3 = T.Text,
		TextSize = T.TextSize,
		Parent = self.Container,
	})
	Corner(6, btn)
	Stroke(T.Border, 1, btn)
	Hover(btn, T.SurfaceAlt, T.SurfaceHov)

	Library:Connect(btn.MouseButton1Click, function()
		ClosePopup()
		task.spawn(fn)
	end)

	local api = {}
	function api:SetText(v) btn.Text = v end
	return api
end

---------------------------------------------------------------- TOGGLE --
function Section:AddToggle(id, opts)
	opts = opts or {}
	local state = opts.Default or false
	local cb = opts.Callback or function() end

	local row = Row(self)
	RowLabel(row, opts.Text or id)

	local track = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(40, 21),
		BackgroundColor3 = state and T.Accent or T.SurfaceAlt,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		Parent = row,
	})
	Corner(11, track)
	local stroke = Stroke(state and T.Accent or T.Border, 1, track)

	local knob = New("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, state and 22 or 3, 0.5, 0),
		Size = UDim2.fromOffset(15, 15),
		BackgroundColor3 = state and Color3.new(1, 1, 1) or T.SubText,
		BorderSizePixel = 0,
		Parent = track,
	})
	Corner(8, knob)

	local obj = { Value = state, Type = "Toggle" }

	function obj:SetValue(v, silent)
		v = not not v
		self.Value = v
		Tween(track, TW.Base, { BackgroundColor3 = v and T.Accent or T.SurfaceAlt })
		Tween(knob, TW.Base, {
			Position = UDim2.new(0, v and 22 or 3, 0.5, 0),
			BackgroundColor3 = v and Color3.new(1, 1, 1) or T.SubText,
		})
		stroke.Color = v and T.Accent or T.Border
		if not silent then task.spawn(cb, v) end
	end

	function obj:OnChanged(fn) cb = fn end

	Library:Connect(track.MouseButton1Click, function()
		ClosePopup()
		obj:SetValue(not obj.Value)
	end)

	Library.Toggles[id] = obj
	return obj
end

---------------------------------------------------------------- SLIDER --
function Section:AddSlider(id, opts)
	opts = opts or {}
	local min      = opts.Min or 0
	local max      = opts.Max or 100
	local rounding = opts.Rounding or 0
	local suffix   = opts.Suffix or ""
	local cb       = opts.Callback or function() end
	local value    = math.clamp(opts.Default or min, min, max)

	local row = Row(self, 44)

	local label = New("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -60, 0, 18),
		Font = T.Font,
		Text = opts.Text or id,
		TextColor3 = T.Text,
		TextSize = T.TextSize,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local readout = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(60, 18),
		BackgroundTransparency = 1,
		Font = T.FontBold,
		Text = "",
		TextColor3 = T.Accent,
		TextSize = T.TextSize,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})

	local track = New("Frame", {
		Position = UDim2.new(0, 0, 0, 26),
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = T.SurfaceAlt,
		BorderSizePixel = 0,
		Parent = row,
	})
	Corner(4, track)

	local fill = New("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = T.Accent,
		BorderSizePixel = 0,
		Parent = track,
	})
	Corner(4, fill)
	New("UIGradient", { Color = ColorSequence.new(T.Accent, T.Accent2), Parent = fill })

	local hit = New("TextButton", {
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.new(0, 0, 0, 19),
		Parent = row,
	})

	local function round(v)
		local m = 10 ^ rounding
		return math.floor(v * m + 0.5) / m
	end

	local obj = { Value = value, Type = "Slider", Min = min, Max = max }

	function obj:SetValue(v, silent)
		v = round(math.clamp(v, min, max))
		local changed = v ~= self.Value
		self.Value = v
		local alpha = (max - min) == 0 and 0 or (v - min) / (max - min)
		fill.Size = UDim2.fromScale(alpha, 1)
		readout.Text = tostring(v) .. suffix
		-- Only fire the callback when the ROUNDED value actually moved.
		-- Dragging a 0-100 integer slider then costs ~100 calls, not ~3000.
		if changed and not silent then task.spawn(cb, v) end
	end

	function obj:OnChanged(fn) cb = fn end
	function obj:SetMax(v) max = v; obj:SetValue(obj.Value, true) end
	function obj:SetMin(v) min = v; obj:SetValue(obj.Value, true) end

	obj:SetValue(value, true)

	local function apply(pos)
		local w = track.AbsoluteSize.X
		if w <= 0 then return end
		local alpha = math.clamp((pos.X - track.AbsolutePosition.X) / w, 0, 1)
		obj:SetValue(min + (max - min) * alpha)
	end

	Library:Connect(hit.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then return end

		ClosePopup()
		Tween(track, TW.Snap, { BackgroundColor3 = T.SurfaceHov })
		BeginDrag(apply, function()
			Tween(track, TW.Snap, { BackgroundColor3 = T.SurfaceAlt })
		end, input.Position)
	end)

	Library.Options[id] = obj
	return obj
end

-------------------------------------------------------------- DROPDOWN --
function Section:AddDropdown(id, opts)
	opts = opts or {}
	local values = opts.Values or {}
	local multi  = opts.Multi or false
	local cb     = opts.Callback or function() end

	local row = Row(self)
	RowLabel(row, opts.Text or id, 0.42)

	local button = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.new(0.56, 0, 0, 26),
		BackgroundColor3 = T.SurfaceAlt,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = T.Font,
		Text = "",
		TextColor3 = T.Text,
		TextSize = T.TextSize,
		Parent = row,
	})
	Corner(6, button)
	Stroke(T.Border, 1, button)
	Hover(button, T.SurfaceAlt, T.SurfaceHov)

	local display = New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(9, 0),
		Size = UDim2.new(1, -28, 1, 0),
		Font = T.Font,
		Text = "...",
		TextColor3 = T.Text,
		TextSize = T.TextSize,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = button,
	})

	local arrow = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -9, 0.5, 0),
		Size = UDim2.fromOffset(12, 12),
		BackgroundTransparency = 1,
		Font = T.Font,
		Text = "v",
		TextColor3 = T.SubText,
		TextSize = 11,
		Parent = button,
	})

	-- Popup lives on the overlay -> never clipped by the scrolling column.
	--
	-- IMPORTANT: the height is computed explicitly. Putting AutomaticSize.Y
	-- and AutomaticCanvasSize.Y on the same ScrollingFrame makes the layout
	-- engine re-measure itself forever and hard-freezes the client.
	local ITEM_H, ITEM_GAP, LIST_PAD, MAX_H = 26, 3, 5, 190

	local popup = New("Frame", {
		Visible = false,
		BackgroundColor3 = T.Titlebar,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(200, 40),
		ClipsDescendants = true,
		ZIndex = 60,
		Parent = Overlay,
	})
	Corner(6, popup)
	Stroke(T.Border, 1, popup)

	local scroller = New("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),        -- fixed, driven by popup height
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = T.Border,
		ZIndex = 61,
		Parent = popup,
	})
	Pad(LIST_PAD, scroller)
	List(ITEM_GAP, scroller)

	local popupHeight = 40

	local obj = { Value = multi and {} or nil, Type = "Dropdown", Values = values }
	local rows = {}

	local function refreshDisplay()
		if multi then
			local picked = {}
			for _, v in ipairs(values) do
				if obj.Value[v] then table.insert(picked, tostring(v)) end
			end
			display.Text = #picked > 0 and table.concat(picked, ", ") or "None"
			display.TextColor3 = #picked > 0 and T.Text or T.SubText
		else
			display.Text = obj.Value ~= nil and tostring(obj.Value) or "None"
			display.TextColor3 = obj.Value ~= nil and T.Text or T.SubText
		end
		for v, r in pairs(rows) do
			local on = multi and obj.Value[v] or (obj.Value == v)
			r.BackgroundColor3 = on and T.Accent or T.Surface
			r.TextColor3 = on and Color3.new(1, 1, 1) or T.SubText
		end
	end

	-- Item buttons are built ONCE and reused. Reopening the dropdown just
	-- flips .Visible instead of destroying and rebuilding the whole list.
	local function build()
		for _, r in pairs(rows) do r:Destroy() end
		rows = {}
		for i, v in ipairs(values) do
			local item = New("TextButton", {
				BackgroundColor3 = T.Surface,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Size = UDim2.new(1, 0, 0, 26),
				LayoutOrder = i,
				Font = T.Font,
				Text = tostring(v),
				TextColor3 = T.SubText,
				TextSize = T.TextSize,
				ZIndex = 62,
				Parent = scroller,
			})
			Corner(5, item)
			rows[v] = item

			Library:Connect(item.MouseButton1Click, function()
				if multi then
					obj.Value[v] = not obj.Value[v] or nil
					refreshDisplay()
					task.spawn(cb, obj.Value)
				else
					obj.Value = v
					refreshDisplay()
					ClosePopup()
					task.spawn(cb, v)
				end
			end)
		end

		-- Height solved once, in Lua, instead of asking the layout engine
		-- to converge on it every frame.
		local n = #values
		popupHeight = math.clamp(n * ITEM_H + math.max(n - 1, 0) * ITEM_GAP + LIST_PAD * 2, 34, MAX_H)
		popup.Size = UDim2.fromOffset(popup.Size.X.Offset, popupHeight)

		refreshDisplay()
	end

	function obj:SetValues(v)
		values = v
		obj.Values = v
		if multi then
			for k in pairs(obj.Value) do
				local keep = false
				for _, nv in ipairs(v) do if nv == k then keep = true break end end
				if not keep then obj.Value[k] = nil end
			end
		end
		build()
	end

	function obj:SetValue(v, silent)
		obj.Value = v
		refreshDisplay()
		if not silent then task.spawn(cb, v) end
	end

	function obj:OnChanged(fn) cb = fn end

	build()

	if opts.Default ~= nil then
		if multi then
			for _, v in ipairs(opts.Default) do obj.Value[v] = true end
		elseif type(opts.Default) == "number" and values[opts.Default] ~= nil then
			obj.Value = values[opts.Default]
		else
			obj.Value = opts.Default
		end
		refreshDisplay()
	end

	Library:Connect(button.MouseButton1Click, function()
		if popup.Visible then
			ClosePopup()
			Tween(arrow, TW.Snap, { Rotation = 0 })
		else
			popup.Size = UDim2.fromOffset(button.AbsoluteSize.X, popupHeight)
			OpenPopup(popup, button)
			Tween(arrow, TW.Snap, { Rotation = 180 })
		end
	end)

	Library.Options[id] = obj
