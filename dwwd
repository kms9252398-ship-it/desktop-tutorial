--  WATERMARK  (optional, throttled to 5 Hz instead of every frame)
--=====================================================================--

local Watermark = New("TextLabel", {
	Visible = false,
	Position = UDim2.fromOffset(16, 16),
	Size = UDim2.fromOffset(0, 26),
	AutomaticSize = Enum.AutomaticSize.X,
	BackgroundColor3 = T.Titlebar,
	BorderSizePixel = 0,
	Font = T.Font,
	Text = "",
	TextColor3 = T.Text,
	TextSize = T.TextSize,
	ZIndex = 70,
	Parent = ScreenGui,
})
Corner(6, Watermark)
Stroke(T.Border, 1, Watermark)
New("UIPadding", {
	PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
	Parent = Watermark,
})

local wmConn, wmTemplate = nil, ""

function Library:SetWatermark(template)
	-- template may contain {fps} and {ping}
	wmTemplate = template
	Watermark.Visible = template ~= nil and template ~= ""

	if wmConn then wmConn:Disconnect() wmConn = nil end
	if not Watermark.Visible then return end

	local accum, frames, last = 0, 0, 0
	wmConn = RunService.Heartbeat:Connect(function(dt)
		accum = accum + dt
		frames = frames + 1
		if accum < 0.2 then return end        -- 5 updates/sec, not 60
		last = math.floor(frames / accum + 0.5)
		accum, frames = 0, 0

		local txt = string.gsub(wmTemplate, "{fps}", tostring(last))
		local ok, ping = pcall(function()
			return math.floor(LocalPlayer:GetNetworkPing() * 1000)
		end)
		txt = string.gsub(txt, "{ping}", ok and tostring(ping) or "0")
		if Watermark.Text ~= txt then
			Watermark.Text = txt
		end
	end)
	table.insert(self._connections, wmConn)
end

--=====================================================================--
--  TEARDOWN
--=====================================================================--

function Library:Unload()
	if self.Unloaded then return end
	self.Unloaded = true

	if wmConn then wmConn:Disconnect() wmConn = nil end
	for _, c in ipairs(self._connections) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(self._connections)
	table.clear(self.Options)
	table.clear(self.Toggles)
	table.clear(self._keybinds)
	self._activeDrag, self._dragEnd, self._keyListener = nil, nil, nil
	self._openPopup = nil

	if ScreenGui then
		ScreenGui:Destroy()
	end
end

function Library:SetAccent(color, color2)
	T.Accent = color
	T.Accent2 = color2 or color
	-- existing controls read the theme lazily; re-apply toggles for instant effect
	for _, o in pairs(self.Toggles) do
		o:SetValue(o.Value, true)
	end
end

return Library
