--==================================================
-- TARGET SYSTEM
--==================================================

local LockedTarget = nil

local function GetCharacterParts(player)

	if not player
		or player == LocalPlayer then

		return nil, nil, nil
	end

	local character =
		player.Character

	if not character then
		return nil, nil, nil
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	local head =
		character:FindFirstChild(
			"Head"
		)

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not humanoid
		or not head
		or not root then

		return nil, nil, nil
	end

	if humanoid.Health <= 0 then
		return nil, nil, nil
	end

	return character, head, root
end

--==================================================
-- LINE OF SIGHT
--==================================================

local function HasLineOfSight(
	fromPosition,
	targetCharacter
)

	if not Settings.RequireLineOfSight then
		return true
	end

	if not targetCharacter then
		return false
	end

	local head =
		targetCharacter:FindFirstChild(
			"Head"
		)

	if not head then
		return false
	end

	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = {
		LocalPlayer.Character,
		Camera
	}

	local result =
		Workspace:Raycast(
			fromPosition,
			head.Position - fromPosition,
			params
		)

	if not result then
		return true
	end

	return result.Instance:IsDescendantOf(
		targetCharacter
	)
end

--==================================================
-- TARGET USABLE
--==================================================

local function IsTargetUsable(player)

	local character, head =
		GetCharacterParts(player)

	if not character
		or not head
		or not Camera then

		return false
	end

	local cameraPosition =
		Camera.CFrame.Position

	local distance =
		(head.Position - cameraPosition).Magnitude

	if distance >
		Settings.AimDistance then

		return false
	end

	if not HasLineOfSight(
		cameraPosition,
		character
	) then

		return false
	end

	return true
end

--==================================================
-- FIND BEST TARGET
--==================================================

local function FindBestTarget()

	if not Camera then
		return nil
	end

	local cameraPosition =
		Camera.CFrame.Position

	local cameraDirection =
		Camera.CFrame.LookVector

	local bestTarget = nil
	local bestScore = math.huge

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if player ~= LocalPlayer then

			local character, head =
				GetCharacterParts(player)

			if character and head then

				local offset =
					head.Position -
					cameraPosition

				local distance =
					offset.Magnitude

				if distance <=
					Settings.AimDistance
					and distance > 0 then

					local dot =
						cameraDirection:Dot(
							offset.Unit
						)

					local angle =
						math.deg(
							math.acos(
								math.clamp(
									dot,
									-1,
									1
								)
							)
						)

					if angle <=
						Settings.AimFOV then

						local visible =
							HasLineOfSight(
								cameraPosition,
								character
							)

						if visible then

							local score =
								(angle * 8)
								+
								(distance * 0.01)

							if score <
								bestScore then

								bestScore =
									score

								bestTarget =
									player
							end
						end
					end
				end
			end
		end
	end

	return bestTarget
end

--==================================================
-- STICKY TARGET
--==================================================

local function GetStickyTarget()

	if LockedTarget then

		if IsTargetUsable(
			LockedTarget
		) then

			return LockedTarget
		end

		LockedTarget = nil
	end

	if not Settings.AimbotEnabled then
		return nil
	end

	LockedTarget =
		FindBestTarget()

	return LockedTarget
end

--==================================================
-- SHARED AIM POINT
--==================================================

local function GetAimPoint()

	local target =
		GetStickyTarget()

	if target then

		local character, head =
			GetCharacterParts(target)

		if character and head then
			return head.Position, target
		end
	end

	if Camera then

		return
			Camera.CFrame.Position
			+
			Camera.CFrame.LookVector * 1000,
			nil
	end

	return nil, nil
end

shared.ChaosGetAimPoint =
	GetAimPoint

shared.ChaosGetTarget =
	GetStickyTarget

--==================================================
-- CHARACTER ROTATION
--==================================================

local DefaultSensitivity =
	UserInputService.MouseDeltaSensitivity

local function RestoreCharacterRotation()

	local character =
		LocalPlayer.Character

	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if humanoid then
		humanoid.AutoRotate = true
	end
end

local function RotateCharacterToTarget(
	targetPosition,
	dt
)

	if not Settings.RotateCharacter then
		return
	end

	local character =
		LocalPlayer.Character

	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not humanoid
		or not root then

		return
	end

	if humanoid.Health <= 0 then
		return
	end

	humanoid.AutoRotate = false

	local rootPosition =
		root.Position

	local flatTarget =
		Vector3.new(
			targetPosition.X,
			rootPosition.Y,
			targetPosition.Z
		)

	local direction =
		flatTarget - rootPosition

	if direction.Magnitude < 0.001 then
		return
	end

	local desiredRoot =
		CFrame.lookAt(
			rootPosition,
			flatTarget
		)

	local alpha =
		math.clamp(
			Settings.BodyRotationSpeed * dt,
			0,
			1
		)

	root.CFrame =
		root.CFrame:Lerp(
			desiredRoot,
			alpha
		)
end

--==================================================
-- EQUIPPED TOOL
--==================================================

local function GetEquippedTool()

	local character =
		LocalPlayer.Character

	if not character then
		return nil
	end

	for _, object in ipairs(
		character:GetChildren()
	) do

		if object:IsA("Tool") then
			return object
		end
	end

	return nil
end

--==================================================
-- WEAPON AIM
--==================================================

local function UpdateWeaponAim(
	targetPosition
)

	if not Settings.WeaponAimEnabled then
		return
	end

	local tool =
		GetEquippedTool()

	if not tool then
		return
	end

	local handle =
		tool:FindFirstChild(
			"Handle"
		)

	if not handle then
		return
	end

	-- 일반 Tool의 경우 서버가 실제 발사를
	-- 어떻게 구현했는지에 따라 Grip을 사용.
	--
	-- Tool 내부에 별도의 ViewModel / Motor6D /
	-- Weld 시스템이 있다면 해당 시스템에서
	-- Camera 방향을 사용해야 한다.

	if handle:IsA("BasePart") then

		-- Tool의 Grip은 단순 보정값만 변경.
		-- 실제 ViewModel 무기는 자체 시스템을 사용.
		local localTarget =
			handle.CFrame:PointToObjectSpace(
				targetPosition
			)

		if localTarget.Magnitude > 0 then

			local direction =
				localTarget.Unit

			-- 무기 자체를 직접 회전시키지 않고
			-- Roblox Tool의 기본 방향을 유지한다.
			-- 실제 총 방향은 Tool/ViewModel 코드에서
			-- Camera 방향을 사용하도록 연결해야 한다.
			_ = direction
		end
	end
end

--==================================================
-- AIM LOOP
--==================================================

RunService:BindToRenderStep(
	"ChaosAim",
	Enum.RenderPriority.Camera.Value + 1,
	function(dt)

		if not Camera then
			return
		end

		if not Settings.Enabled then

			RestoreCharacterRotation()

			UserInputService.MouseDeltaSensitivity =
				DefaultSensitivity

			return
		end

		if not Settings.AimbotEnabled then

			LockedTarget = nil

			RestoreCharacterRotation()

			UserInputService.MouseDeltaSensitivity =
				DefaultSensitivity

			return
		end

		local target =
			GetStickyTarget()

		if not target then

			RestoreCharacterRotation()

			UserInputService.MouseDeltaSensitivity =
				DefaultSensitivity

			return
		end

		local character, head =
			GetCharacterParts(target)

		if not character
			or not head then

			LockedTarget = nil

			RestoreCharacterRotation()

			return
		end

		UserInputService.MouseDeltaSensitivity =
			DefaultSensitivity
			*
			(
				1 -
				math.clamp(
					Settings.AimPower * 0.5,
					0,
					0.5
				)
			)

		local current =
			Camera.CFrame

		local desired =
			CFrame.lookAt(
				current.Position,
				head.Position
			)

		local alpha = 0

		if Settings.AimLockEnabled then

			alpha =
				math.clamp(
					0.90
					+
					Settings.AimPower * 0.10,
					0,
					1
				)

		elseif Settings.AimFollowEnabled then

			alpha =
				math.clamp(
					Settings.AimPower
					*
					Settings.AimSpeed
					*
					60
					*
					dt,
					0,
					0.90
				)
		end

		if alpha > 0 then

			Camera.CFrame =
				current:Lerp(
					desired,
					alpha
				)

			RotateCharacterToTarget(
				head.Position,
				dt
			)

			UpdateWeaponAim(
				head.Position
			)

		else

			RestoreCharacterRotation()
		end
	end
)

