local LastESPUpdate = 0

RunService.Heartbeat:Connect(
	function()

		if not Settings.ESPEnabled
			or not Camera then

			for _, data in pairs(
				ActiveBoxes
			) do

				data.container.Visible =
					false
			end

			return
		end

		local now =
			os.clock()

		if now - LastESPUpdate <
			0.033 then

			return
		end

		LastESPUpdate =
			now

		local cameraPosition =
			Camera.CFrame.Position

		local used = {}

		for _, player in ipairs(
			Players:GetPlayers()
		) do

			if player ~= LocalPlayer
				and player.Character then

				local character =
					player.Character

				local humanoid =
					character:FindFirstChildOfClass(
						"Humanoid"
					)

				local head =
					character:FindFirstChild(
						"Head"
					)

				local root =
					character:FindFirstChild(
						"HumanoidRootPart"
					)
					or
					character:FindFirstChild(
						"UpperTorso"
					)
					or
					character:FindFirstChild(
						"Torso"
					)

				if humanoid
					and head
					and root
					and humanoid.Health > 0 then

					local distance =
						(
							head.Position
							-
							cameraPosition
						).Magnitude

					if distance <=
						Settings.ESPMaxDistance then

						local visible =
							Settings.ESPThroughWalls
							or
							HasLineOfSight(
								cameraPosition,
								character
							)

						if visible then

							local headPosition,
								headVisible =
								Camera:WorldToViewportPoint(
									head.Position
									+
									Vector3.new(
										0,
										0.3,
										0
									)
								)

							local footPosition =
								Camera:WorldToViewportPoint(
									root.Position
									-
									Vector3.new(
										0,
										3,
										0
									)
								)

							if headVisible
								and headPosition.Z > 0 then

								local height =
									math.abs(
										headPosition.Y
										-
										footPosition.Y
									)

								local width =
									height * 0.55

								local data =
									ActiveBoxes[player]

								if not data then

									data = {
										container =
											CreateESPBox()
									}

									ActiveBoxes[player] =
										data
								end

								local container =
									data.container

								container.Size =
									UDim2.fromOffset(
										width,
										height
									)

								container.Position =
									UDim2.fromOffset(
										headPosition.X
										-
										width / 2,
										headPosition.Y
									)

								container.Visible =
									Settings.ESPBox

								local outline =
									container:FindFirstChild(
										"Outline"
									)

								local fill =
									container:FindFirstChild(
										"Fill"
									)

								local distanceLabel =
									container:FindFirstChild(
										"Distance"
									)

								if outline then

									local stroke =
										outline:FindFirstChild(
											"Stroke"
										)

									if stroke then

										stroke.Color =
											Settings.ESPColor

										stroke.Thickness =
											Settings.ESPThickness
									end
								end

								if fill then

									fill.BackgroundColor3 =
										Settings.ESPColor

									fill.Visible =
										Settings.ESPFilled
								end

								if distanceLabel then

									if Settings.ESPDistance then

										distanceLabel.Text =
											math.floor(
												distance
											)
											..
											"m"

									else

										distanceLabel.Text =
											""
									end

									distanceLabel.TextColor3 =
										Settings.ESPColor
								end

								used[player] =
									true
							end
						end
					end
				end
			end
		end

		for player, data in pairs(
			ActiveBoxes
		) do

			if not used[player] then

				data.container.Visible =
					false
			end
		end
	end
)


